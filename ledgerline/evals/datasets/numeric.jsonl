# Numeric-answer golden set.
#
# This is the suite that justifies the table-analyst design. The committed
# baseline is a naive "first number in the top-ranked chunk" extractor, which
# is what a plain RAG pipeline effectively does. It scores badly on purpose --
# it is the *before* half of the ablation that ends up in the README.
#
# `not_disclosed` items must be refused, not guessed. A pipeline that answers
# them is worse than one that scores lower.
{"id": "n-001", "inputs": {"question": "What was net revenue in fiscal 2025?"}, "expected": {"value": "$1,842.6 million", "source": "c-mda-revenue"}, "tags": ["revenue"]}
{"id": "n-002", "inputs": {"question": "What was net revenue in fiscal 2024?"}, "expected": {"value": "$1,639.3 million", "source": "c-mda-revenue"}, "tags": ["revenue", "prior-period"]}
{"id": "n-003", "inputs": {"question": "What was gross margin in fiscal 2025?"}, "expected": {"value": "34.2%", "source": "c-mda-margin"}, "tags": ["margin", "percent"]}
{"id": "n-004", "inputs": {"question": "How much was drawn on the revolving credit facility?"}, "expected": {"value": "$75.0 million", "source": "c-liquidity"}, "tags": ["liquidity", "distractor-heavy"]}
{"id": "n-005", "inputs": {"question": "How much of the revolving facility remained available?"}, "expected": {"value": "$315.4 million", "source": "c-liquidity"}, "tags": ["liquidity", "distractor-heavy"]}

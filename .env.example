# Copy to .env. Nothing here is required to run the test suite or the eval runner
# against fixtures -- only to hit live APIs.

# --- shared ---
DATABASE_URL=postgresql://app:app@localhost:5433/app
LOG_LEVEL=info
CACHE_DIR=data/cache

# --- ledgerline ---
# SEC requires a descriptive User-Agent with a contact address. Requests without
# one are throttled or blocked outright. No API key exists or is needed.
EDGAR_USER_AGENT=YourName your.email@example.com
# SEC's published ceiling is 10 requests/second; we stay well under it.
EDGAR_RATE_LIMIT_RPS=5

# --- sightline ---
# https://www.mapillary.com/dashboard/developers -> create a client token
MAPILLARY_TOKEN=
# Socrata app token: optional, but raises the anonymous rate limit substantially
SOCRATA_APP_TOKEN=
SOCRATA_DOMAIN=data.cityofchicago.org
SOCRATA_DATASET=v6vf-nfxy

# --- model providers (only needed once the agent graphs are wired) ---
ANTHROPIC_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
